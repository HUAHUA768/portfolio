---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pickData = projects.map((p) => ({
  title: p.data.title,
  desc: p.data.tagline,
  stack: p.data.stack.slice(0, 4),
  href: `/projects/${p.id}/`,
}));
---

<Base>
  <div class="page">
    <div class="bento">
      <!-- 个人卡 + 菜单 -->
      <aside class="card profile">
        <img class="avatar" src="/avatar.jpg" alt="HUAHUA768 的头像" />
        <h1>{SITE.name}</h1>
        <span class="status"><i></i>开发中</span>
        <nav class="menu">
          <a href="/blog/">近期文章<span class="arr">→</span></a>
          <a href="/projects/">我的项目<span class="arr">→</span></a>
          <a href="/about/">关于网站<span class="arr">→</span></a>
        </nav>
        <p class="foot-note">C++ / Go · 在读学生</p>
      </aside>

      <!-- 问候卡 -->
      <section class="card greeting">
        <div class="greet-row">
          <img class="avatar-sm" src="/avatar.jpg" alt="" />
          <div>
            <p class="greet-time" id="greet">Good Day</p>
            <h2>I'm HUAHUA, Nice to meet you!</h2>
          </div>
        </div>
        <div class="social">
          <a href={SITE.github} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
          </a>
          {
            SITE.email && (
              <button
                class="copy-mail"
                id="copy-mail"
                type="button"
                data-email={SITE.email}
                aria-label="复制邮箱"
                title="点击复制邮箱"
              >
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="2.5" y="4.5" width="19" height="15" rx="3" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              </button>
            )
          }
        </div>
      </section>

      <!-- 数码管时钟 -->
      <section class="card clock-card">
        <p class="card-label">LOCAL TIME</p>
        <div class="clock" id="clock" aria-label="当前时间"></div>
      </section>

      <!-- 音乐播放器 -->
      <section class="card music-card" id="music-card">
        <div class="disc-wrap"><div class="disc note-disc">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M9 18.5a3 3 0 1 1-2-2.83V5.5l11-2.3v11.3a3 3 0 1 1-2-2.83V6.1L9 7.6v10.9Z" />
          </svg>
        </div></div>
        <div class="music-info">
          <p class="card-label">NOW PLAYING</p>
          <h3>盲选 <span class="artist">· 黄霄雲</span></h3>
          <input id="seek" type="range" min="0" max="100" step="0.1" value="0" aria-label="播放进度" />
          <div class="music-ctrl">
            <span id="cur">0:00</span>
            <button class="play-btn" id="play" aria-label="播放/暂停">
              <svg id="icon-play" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M4 2.5v11l9-5.5-9-5.5Z" />
              </svg>
              <svg id="icon-pause" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" style="display:none">
                <path d="M4 2h3v12H4zM9 2h3v12H9z" />
              </svg>
            </button>
            <span id="dur">--:--</span>
          </div>
        </div>
        <audio id="player" src="/audio/mangxuan.mp3" preload="metadata"></audio>
      </section>

      <!-- 日历卡 -->
      <section class="card calendar-card">
        <div class="cal-head">
          <span class="cal-big" id="cal-big">--</span>
          <div>
            <p class="ym" id="cal-ym">----年--月</p>
            <p id="cal-week">--</p>
          </div>
        </div>
        <div class="cal-grid" id="cal-grid"></div>
      </section>

      <!-- 随机推荐 -->
      <section class="card random-card">
        <p class="card-label">随机推荐 · SHUFFLE</p>
        <h3><a id="rnd-title" href="/projects/">—</a></h3>
        <p class="desc" id="rnd-desc"></p>
        <div class="chips" id="rnd-stack"></div>
        <button class="shuffle" id="rnd-btn" type="button">↻ 换一个</button>
      </section>
    </div>
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
  </div>

  <script type="application/json" id="pick-data" set:html={JSON.stringify(pickData)} />

  <script>
    // ---------- 数码管时钟 ----------
    const SEG: Record<string, string> = {
      '0': 'abcdef', '1': 'bc', '2': 'abged', '3': 'abgcd', '4': 'fgbc',
      '5': 'afgcd', '6': 'afgedc', '7': 'abc', '8': 'abcdefg', '9': 'abcdfg',
    };
    const clock = document.getElementById('clock')!;
    const makeDigit = () => {
      const d = document.createElement('span');
      d.className = 'digit';
      d.innerHTML = ['a', 'b', 'c', 'd', 'e', 'f', 'g']
        .map((s) => `<i class="seg seg-${s}"></i>`)
        .join('');
      return d;
    };
    const digits = [makeDigit(), makeDigit(), makeDigit(), makeDigit()];
    const colon = document.createElement('span');
    colon.className = 'colon';
    colon.textContent = ':';
    clock.append(digits[0], digits[1], colon, digits[2], digits[3]);

    const tick = () => {
      const n = new Date();
      const s =
        String(n.getHours()).padStart(2, '0') + String(n.getMinutes()).padStart(2, '0');
      [...s].forEach((ch, i) => {
        digits[i].querySelectorAll('.seg').forEach((seg) => {
          const k = (seg.className.match(/seg-([a-g])/) as RegExpMatchArray)[1];
          seg.classList.toggle('on', SEG[ch].includes(k));
        });
      });
    };
    tick();
    setInterval(tick, 5000);

    // ---------- 问候语 ----------
    const h = new Date().getHours();
    document.getElementById('greet')!.textContent =
      h >= 5 && h < 11 ? 'Good Morning' : h >= 11 && h < 18 ? 'Good Afternoon' : 'Good Evening';

    // ---------- 日历 ----------
    const now = new Date();
    const y = now.getFullYear();
    const m = now.getMonth();
    document.getElementById('cal-big')!.textContent = String(now.getDate());
    document.getElementById('cal-ym')!.textContent = `${y}年${m + 1}月`;
    document.getElementById('cal-week')!.textContent = `星期${'日一二三四五六'[now.getDay()]}`;
    const grid = document.getElementById('cal-grid')!;
    grid.innerHTML =
      ['一', '二', '三', '四', '五', '六', '日'].map((w) => `<span class="wd">${w}</span>`).join('') +
      Array.from({ length: (new Date(y, m, 1).getDay() + 6) % 7 }, () => '<span></span>').join('') +
      Array.from({ length: new Date(y, m + 1, 0).getDate() }, (_, i) => {
        const d = i + 1;
        return `<span class="cal-cell${d === now.getDate() ? ' today' : ''}">${d}</span>`;
      }).join('');

    // ---------- 随机推荐 ----------
    const picks: { title: string; desc: string; stack: string[]; href: string }[] = JSON.parse(
      document.getElementById('pick-data')!.textContent!,
    );
    const rndTitle = document.getElementById('rnd-title')!;
    const rndDesc = document.getElementById('rnd-desc')!;
    const rndStack = document.getElementById('rnd-stack')!;
    const pick = () => {
      const p = picks[Math.floor(Math.random() * picks.length)];
      rndTitle.textContent = p.title;
      rndTitle.href = p.href;
      rndDesc.textContent = p.desc;
      rndStack.innerHTML = p.stack.map((s) => `<span class="chip">${s}</span>`).join('');
    };
    document.getElementById('rnd-btn')!.addEventListener('click', pick);
    pick();

    // ---------- 复制邮箱 ----------
    const mailBtn = document.getElementById('copy-mail') as HTMLButtonElement | null;
    const toast = document.getElementById('toast')!;
    let toastTimer: number | undefined;

    const showToast = (text: string) => {
      toast.textContent = text;
      toast.classList.add('show');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => toast.classList.remove('show'), 1800);
    };

    mailBtn?.addEventListener('click', async () => {
      const email = mailBtn.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = email;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      showToast(`已复制邮箱：${email}`);
    });

    // ---------- 音乐播放器 ----------
    const audio = document.getElementById('player') as HTMLAudioElement;
    const card = document.getElementById('music-card')!;
    const iconPlay = document.getElementById('icon-play')!;
    const iconPause = document.getElementById('icon-pause')!;
    const seek = document.getElementById('seek') as HTMLInputElement;
    const cur = document.getElementById('cur')!;
    const dur = document.getElementById('dur')!;
    const fmt = (t: number) =>
      `${Math.floor(t / 60)}:${String(Math.floor(t % 60)).padStart(2, '0')}`;

    audio.addEventListener('loadedmetadata', () => (dur.textContent = fmt(audio.duration)));
    document.getElementById('play')!.addEventListener('click', () =>
      audio.paused ? audio.play() : audio.pause(),
    );
    audio.addEventListener('play', () => {
      card.classList.add('playing');
      iconPlay.style.display = 'none';
      iconPause.style.display = '';
    });
    audio.addEventListener('pause', () => {
      card.classList.remove('playing');
      iconPlay.style.display = '';
      iconPause.style.display = 'none';
    });
    audio.addEventListener('timeupdate', () => {
      cur.textContent = fmt(audio.currentTime);
      if (audio.duration) {
        const v = (audio.currentTime / audio.duration) * 100;
        seek.value = String(v);
        seek.style.setProperty('--fill', `${v}%`);
      }
    });
    seek.addEventListener('input', () => {
      if (audio.duration) {
        audio.currentTime = (Number(seek.value) / 100) * audio.duration;
        seek.style.setProperty('--fill', `${seek.value}%`);
      }
    });
  </script>
</Base>
