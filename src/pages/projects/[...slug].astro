---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.tagline}>
  <div class="wrap">
    <article class="article">
      <a class="back" href="/projects/">← 返回项目列表</a>
      <h1>{project.data.title}</h1>
      <p class="tagline">{project.data.tagline}</p>
      <div class="meta">
        <span>{project.data.year}</span>
        {
          project.data.status && (
            <>
              <span>·</span>
              <span>{project.data.status}</span>
            </>
          )
        }
        <span>·</span>
        {project.data.stack.map((item) => <span class="chip">{item}</span>)}
        {
          project.data.repo && (
            <>
              <a class="back" href={project.data.repo} target="_blank" rel="noreferrer">
                查看源码 ↗
              </a>
            </>
          )
        }
      </div>
      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</Base>
